# Wajib
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Opsional (default: 8080)
PORT=8080

# Opsional — kalau kosong, upload foto produk fallback ke folder lokal ./uploads
# (TIDAK persisten di hosting dengan filesystem ephemeral seperti Render free tier).
# Isi ketiganya dari dashboard Cloudinary (cloudinary.com) -> Dashboard -> Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opsional — validasi kode toko 7-Eleven/FamilyMart lewat ECPay Logistics GetStoreList.
#
# ECPAY_LOGISTICS_ENV adalah SATU SAKLAR untuk pindah staging <-> production:
#   - staging (default): jalan otomatis tanpa perlu isi apa pun di bawah ini — memakai akun
#     TEST resmi milik ECPay sendiri (MerchantID 2000132) ke endpoint stage. Hanya mengembalikan
#     data toko contoh, bukan data toko sungguhan.
#   - production: pindah ke endpoint produksi ECPay. TIDAK ada default untuk MerchantID/HashKey/
#     HashIV pada mode ini — wajib diisi manual dengan kredensial produksi milik klien di bawah.
#     Kalau dikosongkan, fitur validasi kode toko otomatis nonaktif (soft-disable, tidak bikin
#     error) sampai kredensial asli diisi.
ECPAY_LOGISTICS_ENV=staging

# Wajib diisi HANYA kalau ECPAY_LOGISTICS_ENV=production. Ambil dari akun ECPay produksi klien
# setelah layanan Logistik CVS aktif di akun mereka. Kosongkan kalau ECPAY_LOGISTICS_ENV=staging
# (nilai TEST resmi ECPay otomatis dipakai).
ECPAY_LOGISTICS_MERCHANT_ID=
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=

# Opsional — override manual URL endpoint ECPay kalau perlu. Biasanya tidak perlu diisi:
# ECPAY_LOGISTICS_ENV sudah otomatis memilih https://logistics-stage.ecpay.com.tw (staging) atau
# https://logistics.ecpay.com.tw (production).
ECPAY_LOGISTICS_BASE_URL=

# Wajib
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Opsional (default: 8080)
PORT=8080

# Opsional — kalau kosong, upload foto produk fallback ke folder lokal ./uploads
# (TIDAK persisten di hosting dengan filesystem ephemeral seperti Render free tier).
# Isi ketiganya dari dashboard Cloudinary (cloudinary.com) -> Dashboard -> Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Template untuk deploy VPS (docker-compose.prod.yml). Copy ke ".env" di root repo lalu isi
# nilai aslinya - JANGAN commit file ".env" (sudah ada di .gitignore untuk pola ini). Lihat
# docs/DEPLOYMENT_VPS.md untuk panduan lengkap.

# ============ Wajib ============

# Kredensial Postgres - bebas isi apa saja, ini akun internal yang hanya dipakai oleh container
# backend untuk connect ke container db (tidak reachable dari luar VPS sama sekali).
POSTGRES_USER=ksshop
POSTGRES_PASSWORD=ganti-dengan-password-acak-yang-panjang
POSTGRES_DB=ordermgmt

# String acak panjang untuk menandatangani token login (JWT). Generate dengan:
#   openssl rand -hex 32
JWT_SECRET=ganti-dengan-hasil-openssl-rand-hex-32

# URL publik aplikasi - dipakai untuk membangun link di email (invite staff, reset password).
# Isi dengan IP VPS Anda, contoh: http://103.xxx.xxx.xxx (tanpa trailing slash, tanpa /api).
APP_BASE_URL=http://GANTI_DENGAN_IP_VPS_ANDA

# ============ Opsional — upload foto produk ============
# Kalau kosong, foto produk disimpan di volume Docker lokal (persisten, tapi tidak di-backup
# otomatis dan tidak punya CDN). Isi ketiganya dari dashboard Cloudinary (cloudinary.com) kalau
# mau upload foto produk ke Cloudinary sebagai gantinya.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ Opsional — kirim email sungguhan ============
# Kalau SMTP_HOST kosong, email (kode login OTP, link invite/reset password) hanya dicatat di
# log backend (docker compose logs backend), TIDAK benar-benar terkirim - baik untuk uji coba
# awal, tapi isi ini begitu siap dipakai staf sungguhan. Contoh: Gmail smtp.gmail.com:587 dengan
# App Password (bukan password akun biasa - buat di myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@ks-shop.local

# ============ Opsional — validasi kode toko 7-Eleven/FamilyMart (ECPay) ============
# Default staging bekerja tanpa diisi (akun TEST resmi ECPay). Isi MERCHANT_ID/HASH_KEY/HASH_IV
# dan ubah ENV ke "production" begitu akun ECPay produksi klien sudah aktif layanan Logistik CVS.
ECPAY_LOGISTICS_ENV=staging
ECPAY_LOGISTICS_MERCHANT_ID=
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=
ECPAY_LOGISTICS_BASE_URL=
